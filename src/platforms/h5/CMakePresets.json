{
  "version": 6,
  "configurePresets": [
    {
      "name": "h5",
      "displayName": "STM32H5",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/src/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "STM32_PLATFORM_DIR": "${sourceDir}/src/platforms/h5",
        "STM32_DEVICE": "STM32H563xx"
      }
    },
    {
      "name": "stm32h563",
      "displayName": "STM32H563xx",
      "inherits": "h5",
      "cacheVariables": {
        "PRESET_NAME": "stm32h563",
        "PYOCD_TARGET": "stm32h563zitx",
        "GPIO_DRIVER_DIR": "${sourceDir}/src/drivers/gpio-h563",
        "I2C_DRIVER_DIR": null,
        "UART_DRIVER_DIR": null,
        "SPI_DRIVER_DIR": null,
        "DMA_DRIVER_DIR": null,
        "CAN_DRIVER_DIR": null
      }
    }
  ],
  "buildPresets": [
    { "name": "h5",        "configurePreset": "h5" },
    { "name": "stm32h563", "configurePreset": "stm32h563" }
  ]
}
