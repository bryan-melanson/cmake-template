{
  "version": 6,
  "include": [
    "../../drivers/gpio-g0b1/CMakePresets.json"
  ],
  "configurePresets": [
    {
      "name": "g0",
      "displayName": "STM32G0",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/src/cmake/toolchain-arm-none-eabi.cmake",
      "cacheVariables": {
        "STM32_PLATFORM_DIR": "${sourceDir}/src/platforms/g0",
        "STM32_DEVICE": "STM32G0B1xx"
      }
    },
    {
      "name": "stm32g0b1",
      "displayName": "STM32G0B1xx",
      "inherits": ["g0", "gpio-g0b1"],
      "cacheVariables": {
        "PRESET_NAME": "stm32g0b1",
        "PYOCD_TARGET": "stm32g0b1retx"
      }
    }
  ],
  "buildPresets": [
    { "name": "g0",        "configurePreset": "g0" },
    { "name": "stm32g0b1", "configurePreset": "stm32g0b1" }
  ]
}
