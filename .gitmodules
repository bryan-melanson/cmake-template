# ── GPIO driver libraries (pull only the family you need) ─────────────────────
[submodule "libs/gpio-g0"]
    path = libs/gpio-g0
    url  = https://github.com/YOUR_ORG/gpio-g0.git

[submodule "libs/gpio-h5"]
    path = libs/gpio-h5
    url  = https://github.com/YOUR_ORG/gpio-h5.git

# ── Platform configuration repos ──────────────────────────────────────────────
# Each platform repo contains: platform.cmake, CMakePresets.json, linker/
# Replace URLs below with your hosted platform repos, then run:
#   git rm -r platforms/stm32g0
#   git submodule add <url> platforms/stm32g0
[submodule "platforms/stm32g0"]
    path = platforms/stm32g0
    url  = https://github.com/YOUR_ORG/stm32-platform-g0.git

[submodule "platforms/stm32h5"]
    path = platforms/stm32h5
    url  = https://github.com/YOUR_ORG/stm32-platform-h5.git
