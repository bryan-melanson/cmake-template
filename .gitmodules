# ── GPIO driver submodules (pull only the chip you need) ─────────────────────
[submodule "src/drivers/gpio-g0b1"]
    path = src/drivers/gpio-g0b1
    url  = https://github.com/YOUR_ORG/gpio-g0b1.git

[submodule "src/drivers/gpio-h563"]
    path = src/drivers/gpio-h563
    url  = https://github.com/YOUR_ORG/gpio-h563.git

# ── Platform family submodules ────────────────────────────────────────────────
# Each family repo contains: platform.cmake, CMakePresets.json, linker/
# Chip variants within a family are selected by the preset's STM32_DEVICE.
# Replace URLs below with your hosted platform repos, then run:
#   git submodule add <url> src/platforms/g0
#   git submodule add <url> src/platforms/h5
[submodule "src/platforms/g0"]
    path = src/platforms/g0
    url  = https://github.com/YOUR_ORG/stm32-platform-g0.git

[submodule "src/platforms/h5"]
    path = src/platforms/h5
    url  = https://github.com/YOUR_ORG/stm32-platform-h5.git
