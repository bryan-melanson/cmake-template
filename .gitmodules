# ── GPIO driver submodules (pull only the chip you need) ─────────────────────
[submodule "drivers/gpio-g0b1"]
    path = drivers/gpio-g0b1
    url  = https://github.com/YOUR_ORG/gpio-g0b1.git

[submodule "drivers/gpio-h563"]
    path = drivers/gpio-h563
    url  = https://github.com/YOUR_ORG/gpio-h563.git

# ── Platform configuration submodules ────────────────────────────────────────
# Each platform repo contains: platform.cmake, CMakePresets.json, linker/
# Replace URLs below with your hosted platform repos, then run:
#   git rm -r platforms/stm32g0b1
#   git submodule add <url> platforms/stm32g0b1
[submodule "platforms/stm32g0b1"]
    path = platforms/stm32g0b1
    url  = https://github.com/YOUR_ORG/stm32-platform-g0b1.git

[submodule "platforms/stm32h563"]
    path = platforms/stm32h563
    url  = https://github.com/YOUR_ORG/stm32-platform-h563.git
